<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OwnVocalRemover</RootNamespace>
    <AssemblyName>OwnVocalRemover</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OwnVocalRemover</PackageId>
    <Version>1.0.0</Version>
    <Authors>ModernMube</Authors>
    <Description>Standalone vocal remover / audio source separation package built on OwnAudioSharp. Provides simplified, HTDemucs and multi-model ONNX-based separators.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ModernMube/OwnVocalRemover</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ModernMube/OwnVocalRemover</RepositoryUrl>
    <PackageTags>audio;vocal-remover;source-separation;onnx;ownaudio;htdemucs</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1570;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <PackageReference Include="OwnAudioSharp" Version="3.1.7" />
  </ItemGroup>

</Project>
